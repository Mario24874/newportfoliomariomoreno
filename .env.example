# Environment Variables for Portfolio

# ElevenLabs Configuration
# Get your agent ID from ElevenLabs dashboard
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# n8n Configuration (for AI Chatbot automation)
# Configure your n8n webhook URL for automated AI responses
VITE_N8N_WEBHOOK_URL=https://n8n-n8n.geu10q.easypanel.host/webhook/bot-portfolio

# n8n Consultation Scheduling (Google Calendar integration)
# Configure your n8n webhook URL for consultation scheduling
VITE_N8N_CONSULTATION_WEBHOOK_URL=https://n8n-n8n.geu10q.easypanel.host/webhook/agendas-consultas-mario-moreno

# Contact Information (Optional - can be configured in portfolioData.ts)
VITE_EMAIL=your.email@example.com
VITE_PHONE=+1234567890
VITE_WHATSAPP=+1234567890
VITE_LINKEDIN_URL=https://linkedin.com/in/yourprofile
VITE_GITHUB_URL=https://github.com/yourusername

# Supabase — Portal admin de métricas (/admin) y analítica del portfolio
# Project URL + anon (public) key del proyecto Supabase. Claves PÚBLICAS de cliente:
# seguras en el navegador; la seguridad real la da el RLS. NUNCA poner service_role aquí.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Correos con acceso al panel /admin (CSV). Por defecto solo el owner.
VITE_ADMIN_EMAILS=marioivanmorenopineda@gmail.com

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
VITE_HOTJAR_ID=your_hotjar_id

# Feature Flags (Optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT_WIDGET=true
VITE_ENABLE_VOICE_ASSISTANT=true

# Development Settings
VITE_API_BASE_URL=https://api.yourbackend.com
VITE_DEBUG_MODE=false