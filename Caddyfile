:80 {
    root * /srv
    encode gzip

    # Redirect www → non-www (301 permanent)
    @www host www.mariomoreno.work
    redir @www https://mariomoreno.work{uri} 301

    # -------------------------------------------------------------------------
    # Reverse proxy for n8n webhooks — avoids CORS from browser
    # All /proxy/n8n/* requests are forwarded to the n8n instance
    # -------------------------------------------------------------------------
    handle /proxy/n8n/* {
        uri strip_prefix /proxy/n8n
        reverse_proxy https://n8n-n8n.qr7yo1.easypanel.host {
            header_up Host n8n-n8n.qr7yo1.easypanel.host
            header_up X-Forwarded-Proto https
        }
    }

    # Privacy Policy lives on the app (Meta App Review requirement).
    # Redirect before the SPA catch-all so /privacy never serves the homepage.
    handle /privacy {
        redir * https://app.mariomoreno.work/privacy 301
    }

    # SPA routing: redirect all non-file requests to index.html
    handle {
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' https://elevenlabs.io https://*.elevenlabs.io; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://elevenlabs.io https://*.elevenlabs.io https://api.elevenlabs.io https://convai.elevenlabs.io https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://*.clarity.ms https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://convai.elevenlabs.io wss://convai.elevenlabs.io https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://*.clarity.ms https://www.googletagmanager.com https://n8n-n8n.qr7yo1.easypanel.host wss://generativelanguage.googleapis.com https://generativelanguage.googleapis.com https://app.mariomoreno.work https://challenges.cloudflare.com; frame-src 'self' https://elevenlabs.io https://*.elevenlabs.io https://convai.elevenlabs.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://elevenlabs.io https://*.elevenlabs.io https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://elevenlabs.io https://*.elevenlabs.io https://fonts.googleapis.com; img-src 'self' data: blob: https: https://*.elevenlabs.io https://www.google-analytics.com; media-src 'self' blob: https: https://*.elevenlabs.io; worker-src 'self' blob: https://elevenlabs.io https://*.elevenlabs.io; child-src 'self' blob: https://elevenlabs.io https://*.elevenlabs.io; font-src 'self' data: https://elevenlabs.io https://*.elevenlabs.io https://fonts.gstatic.com;"
        -Server
    }

    # Cache static assets
    @assets {
        path /assets/*
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Cache images
    @images {
        path /images/*
    }
    header @images Cache-Control "public, max-age=31536000"

    log {
        output stdout
        format json
    }
}
