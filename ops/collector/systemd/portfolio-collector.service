[Unit]
Description=Colector de analítica del portfolio (visitas, demos, contacto) -> Supabase, sin IA
After=network-online.target

[Service]
Environment=COLLECTOR_HOST=172.18.0.1
Environment=COLLECTOR_PORT=8788
ExecStart=/usr/bin/python3 -I /opt/portfolio-collector/collector.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/avisador

[Install]
WantedBy=multi-user.target
